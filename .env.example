# Copy this file to .env and fill in real values. .env is gitignored.

# --- Local development (Supabase CLI) ---
# `supabase start` runs a full local Supabase stack in Docker.
# Default local Postgres URL is postgresql://postgres:postgres@127.0.0.1:54322/postgres
# (this machine's supabase/config.toml offsets ports by +100 to avoid clashing with
# another local Supabase project, so locally it's 127.0.0.1:54422 instead — check
# `supabase status` output for the actual port in use).
# DATABASE_URL and DIRECT_URL are identical locally: no connection pooler runs locally.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Production (Supabase project) ---
# From your Supabase project's Connect dialog:
# DATABASE_URL = pooled connection (port 6543, via PgBouncer/Supavisor) — used by the app at runtime
# DIRECT_URL   = direct connection (port 5432) — used only for running migrations
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Image storage (Supabase Storage) ---
# Server-side only. Product photos are uploaded through the app, never straight from the browser.
# Local: put these in .env.local (`supabase status -o env` shows API_URL and SERVICE_ROLE_KEY).
# Production: the project's URL and its service_role key (keep it secret; never prefix with NEXT_PUBLIC_).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Signs website customer sign-in tokens (generate with: openssl rand -hex 32).
# Changing it signs every customer out.
WEBSITE_AUTH_SECRET=
